# Bu dosyayı .env olarak kopyalayıp doldurun. .env asla commit edilmemeli.

# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# Opsiyonel: Doluysa slash komutlar sadece bu sunucuya kaydedilir (geliştirme/test için).
# Boşsa bot bulunduğu her sunucuya anında kaydeder; yeni eklendiği sunucuya da katıldığı an.
DEV_GUILD_ID=

# PostgreSQL (docker-compose.yml bu üç değeri kullanır)
POSTGRES_USER=bot
POSTGRES_PASSWORD=degistir-beni
POSTGRES_DB=discord_bot
DATABASE_URL=postgres://bot:degistir-beni@127.0.0.1:5432/discord_bot
# Opsiyonel, varsayılan 10
DB_MAX_CONNECTIONS=10

# Redis (docker-compose.yml REDIS_PASSWORD'ü kullanır)
REDIS_PASSWORD=degistir-beni
REDIS_URL=redis://:degistir-beni@127.0.0.1:6379

# tracing filtre seviyesi (trace, debug, info, warn, error)
RUST_LOG=info,serenity=warn,sqlx=warn,songbird=warn
# Logların ayrıca yazılacağı klasör (günlük dosyalar, son 7 gün). Boşsa sadece konsola yazılır.
LOG_DIR=logs

# ---------- Yapay zekâ (opsiyonel; biri yeterli) ----------
# NVIDIA NIM anahtarı: https://build.nvidia.com/settings/api-keys  (nvapi- ile başlar)
NVIDIA_API_KEY=
# Google Gemini anahtarı: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# İkisi de doluysa hangisi kullanılsın: nim veya gemini (boşsa önce NVIDIA)
AI_PROVIDER=
# Model adı (boşsa NIM: nvidia/nemotron-3-ultra-550b-a55b, Gemini: gemini-flash-lite-latest)
AI_MODEL=
# Botun kişiliği (boşsa varsayılan Türkçe asistan)
AI_SYSTEM_PROMPT=
# Web araması (NVIDIA için; Gemini kendi Google aramasını kullanır): https://app.tavily.com → API Keys (tvly- ile başlar)
TAVILY_API_KEY=

# ---------- Yayın duyuruları (opsiyonel) ----------
# Twitch: https://dev.twitch.tv/console/apps → Uygulama kaydet → Client ID + New Secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Kick: https://kick.com/settings/developer → Uygulama oluştur → Client ID + Secret
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Kaç saniyede bir kontrol edilsin (en az 30, varsayılan 60)
STREAM_POLL_SECS=60

# ---------- Yerel web araması (SearXNG, üyelik gerektirmez) ----------
# docker-compose.yml içindeki searxng servisi; yapay zekâ güncel bilgi için bunu kullanır.
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_SECRET=degistir-beni

# --- Ban itirazı web formu (isteğe bağlı) ---
# Bot internetten erişilebilir bir adreste çalışıyorsa (7/24 sunucu) doldurun; boşsa form kapalıdır
# ve itirazlar itiraz sunucusu + DM butonuyla yapılır.
# Yasak DM'inde "Web'den itiraz et" bağlantısı bu adrese gider: <WEB_PUBLIC_URL>/itiraz/<anahtar>
WEB_PUBLIC_URL=
# Botun dinlediği adres (varsayılan 0.0.0.0:8080; önüne HTTPS veren bir ters vekil koyun)
WEB_BIND=

# ---------- İsteğe bağlı ek servisler ----------
# /ara imgur: https://imgur.com → Settings → Applications → uygulama oluştur → Client ID
IMGUR_CLIENT_ID=
# /akış ekle X / Instagram / TikTok: RSSHub uyumlu bir RSS köprüsünün adresi (ör. http://rsshub:1200).
# Bu siteler açık akış vermez; köprüyü kendin çalıştırman ve o sitelerin oturum bilgisini köprüye girmen gerekir.
RSS_BRIDGE_URL=
# Panele "Discord ile giriş": Developer Portal → uygulaman → OAuth2 → Client Secret (Reset Secret).
# Aynı sayfada Redirects'e paneldeki Sistem sayfasında yazan adresi ekle (…/panel/oauth).
DISCORD_CLIENT_SECRET=
# /hayal-et modeli (NVIDIA_API_KEY ile çalışır; boşsa black-forest-labs/flux.1-dev)
AI_IMAGE_MODEL=
# Hata bildirimleri: bir Discord kanalında Kanalı Düzenle → Entegrasyonlar → Webhook oluştur → adresini yaz.
# Boşsa kritik hatalar bot sahibine özel mesaj olarak gelir. Dışarıdan izleme için: <panel adresi>/saglik
ALERT_WEBHOOK_URL=
# /çevir ve /hayal-et komutlarını kullanıcı hesabına kurulabilir yapar (her sunucuda ve özel mesajda çalışır).
# Önce Developer Portal → uygulaman → Installation → "User Install" kutusunu işaretle; sonra buraya 1 yaz.
USER_INSTALL=

# Spotify (isteğe bağlı): /çal şarkı adını önce Spotify'da arar; ses YouTube'dan çalınır.
# developer.spotify.com/dashboard → Create app → Client ID + Client secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# /tavsiye (isteğe bağlı): film ve dizi TMDB'den (themoviedb.org → Ayarlar → API → "API Key"),
# oyun RAWG'dan (rawg.io/apidocs → Get API Key). IMDb puanı anahtarsız gelir.
TMDB_API_KEY=
RAWG_API_KEY=
